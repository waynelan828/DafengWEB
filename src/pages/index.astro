---
    import Layout from '~/layouts/PageLayout.astro';

    import HeroCarousel from '~/components/widgets/HeroCarousel.astro';
    import Features from '~/components/widgets/Features.astro';
    import Features2 from '~/components/widgets/Features2.astro';
    import Steps2 from '~/components/widgets/Steps2.astro';
    import Testimonials from '~/components/widgets/Testimonials.astro';
    import FAQs from '~/components/widgets/FAQs.astro';
    import ItemGrid from '~/components/ui/ItemGrid.astro';

    /*
     * 本檔案為網站首頁。原始版本以屋主為主要對象，
     * 此修改版針對室內設計公司與獨立設計師的 B2B 合作需求重寫文案，
     * 並更新主視覺圖片與標題，使內容更貼近台灣室內設計產業的合作情境。
     */

    const metadata = {
      title: '大鋒工程｜設計師專屬木作合作夥伴',
      description:
        '與室內設計公司及獨立設計師合作的專業木作團隊，提供一站式木作工程與施工服務，讓創意如期落實。',
    };
---

    <Layout metadata={metadata}>
      <!-- Hero：首頁主視覺 -->

      <HeroCarousel
        autoplayDelay={5000}
        slides={[
          {
            image: {
              src: '/images/hero_Banner_1.png',
              alt: '木作工班與設計師合作示意圖',
            },
            tagline: '設計師夥伴',
            title: '與設計師共創空間',
            subtitle: '從圖面到完工，協助落實設計靈感',
            description: '木作工程合作專家',
            overlayClass: 'bg-slate-900/55',
            align: 'left',
          },
          {
            image: {
              src: '/images/hero_Banner_2.png',
              alt: '木作工廠支援高效率施作示意圖',
            },
            tagline: '效率與品質',
            title: '工廠支援，工地無憂',
            subtitle: '縮短施作時間，確保交期與品質',
            description: '專為設計師打造的穩定工班',
            overlayClass: 'bg-slate-900/55',
            align: 'center',
          },
          {
            image: {
              src: '/images/hero_Banner_3.png',
              alt: '木作團隊與設計師溝通協作示意圖',
            },
            tagline: '溝通無礙',
            title: '專業團隊安心托付',
            subtitle: '讓你專注設計，我們搞定施工',
            description: '可靠的B2B木作夥伴',
            overlayClass: 'bg-slate-900/55',
            align: 'right',
          },
        ]}
      />

      <!-- 核心優勢 -->

      <Features
        id="features"
        tagline="合作優勢"
        title="您的木作工程外包夥伴"
        subtitle="透明流程 × 專屬工班 × 交期可靠"
        items={[
          {
            title: '一站式整合',
            description:
              '木作、泥作、水電、油漆、玻璃鐵件統包協調，單一窗口負責到底。',
            icon: 'tabler:box-multiple',
          },
          {
            title: '報價清楚透明',
            description:
              '分項明細與用料規格完整揭示，變更加價先溝通再施作。',
            icon: 'tabler:receipt-2',
          },
          {
            title: '工期嚴謹控管',
            description:
              '以里程碑管理關鍵工序，即時回報現場狀況，準時完工。',
            icon: 'tabler:timeline',
          },
          {
            title: '品質驗收標準',
            description:
              '木作收邊、垂直水平、接縫與表面平整度皆有書面標準。',
            icon: 'tabler:checklist',
          },
          {
            title: '工地安全與清潔',
            description:
              '每日收整工區、妥善防塵與養護，完工交屋前專業清潔。',
            icon: 'tabler:shield-check',
          },
          {
            title: '完善保固',
            description:
              '提供保固與到府售後服務，讓您入住無後顧之憂。',
            icon: 'tabler:award',
          },
        ]}
      />

      <!-- 核心服務 -->

      <Features2
        tagline="服務項目"
        title="專為室內設計打造的木作方案"
        subtitle="住宅與商業空間全面支持"
        items={[
          {
            title: '室內裝修統包',
            description: '格局調整、隔間、門片、地坪、天花、油漆與軟裝整合。',
            icon: 'tabler:home-cog',
          },
          {
            title: '木作與系統櫃',
            description:
              '電視牆、收納櫃、衣櫃與床架；手作木工與系統板材皆可。',
            icon: 'tabler:wood',
          },
          {
            title: '水電/泥作/油漆',
            description:
              '配管配線、衛浴與磁磚、批土與塗裝，工序密合與美觀兼顧。',
            icon: 'tabler:tools',
          },
          {
            title: '玻璃鐵件/地板/窗簾',
            description:
              '強化玻璃、烤漆鐵件、超耐磨地板、百葉與遮光簾一次到位。',
            icon: 'tabler:layers-intersect',
          },
          {
            title: '老屋翻修與管線更新',
            description: '結構評估、廚衛更新、配電與防漏處理，安全第一。',
            icon: 'tabler:building-warehouse',
          },
          {
            title: '設計配合與3D',
            description: '可配合設計師或提供3D示意，協助您預先想像成果。',
            icon: 'tabler:box-align-top-left',
          },
        ]}
      />

      <!-- 案例展示 -->
      <section class="relative w-full py-16 md:py-24 lg:py-28">
        <div class="container">
          <div class="mx-auto max-w-3xl text-center">
            <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl">
              案例展示
            </h2>
            <p class="mt-4 text-muted">精選住宅與商空實績，更多請看完整作品集。</p>
          </div>

          <div class="mt-10">
            <ItemGrid
              columns={3}
              items={[
                {
                  title: '內湖｜現代簡約宅',
                  description: '電視主牆、系統收納與臥室衣櫃',
                  callToAction: { text: '查看個案', href: '/portfolio/neihu-modern' },
                },
                {
                  title: '信義區｜辦公室改造',
                  description: '玻璃隔間、公共區域動線優化',
                  callToAction: { text: '查看個案', href: '/portfolio/xinyi-office' },
                },
                {
                  title: '新竹｜Loft 風格宅',
                  description: '開放式廚房與鐵件木作',
                  callToAction: { text: '查看個案', href: '/portfolio/hsinchu-loft' },
                },
              ]}
            />
          </div>
        </div>
      </section>

      <!-- 服務流程（精簡版） -->
      <Steps2
        tagline="流程"
        title="從諮詢到交屋，我們陪你走完全程"
        items={[
          {
            title: '1. 線上諮詢與初估',
            description: '瞭解需求與預算範圍，提供大致工法與建議。',
            icon: 'tabler:message-check',
          },
          {
            title: '2. 現場丈量與討論',
            description: '安排到府勘查、確認尺寸與動線，蒐集細節。',
            icon: 'tabler:ruler-measure',
          },
          {
            title: '3. 圖面與正式報價',
            description: '依設計圖或需求列出分項明細與材料規格。',
            icon: 'tabler:file-description',
          },
          {
            title: '4. 簽約與排程',
            description: '確認工期里程碑與付款節點，進場前預告。',
            icon: 'tabler:calendar-event',
          },
          {
            title: '5. 施作與階段驗收',
            description: '重要工序到場說明，完工前共同檢核缺失。',
            icon: 'tabler:clipboard-check',
          },
          {
            title: '6. 交屋與保固',
            description: '完工交付文件與保固說明，後續服務不間斷。',
            icon: 'tabler:home-check',
          },
        ]}
      />

      <!-- 客戶見證 -->
      <Testimonials
        title="客戶見證"
        testimonials={[
          {
            testimonial:
              '團隊配合設計師的專業度高，報價透明、施工品質精準，是值得信賴的合作夥伴。',
            name: '陳先生',
            job: '室內設計師｜台北',
          },
          {
            testimonial:
              '能夠理解設計圖想表達的細節，現場問題也能立即反饋，合作非常順利。',
            name: '李小姐',
            job: '室內設計師｜新北',
          },
          {
            testimonial:
              '在商業空間改造時，團隊協助規劃工期避免影響營運，專業又貼心。',
            name: '王經理',
            job: '設計公司｜商空案',
          },
        ]}
      />

      <!-- 常見問題 -->
      <FAQs
        title="常見問題 FAQ"
        tagline="FAQ"
        classes={{ container: 'max-w-6xl' }}
        items={[
          {
            title: '合作流程如何進行？',
            description:
              '請提供設計圖或需求大綱與預算，我們提供初估與建議，並安排現場丈量。',
          },
          {
            title: '設計變更會影響報價嗎？',
            description:
              '若設計或材料規格調整，我們會於施作前溝通並更新報價，以保障雙方權益。',
          },
          {
            title: '工期大約多久？',
            description:
              '依案量及難度而定，單一空間 2–4 週，整體案子 6–12 週，具體時程於合約中明確約定。',
          },
          {
            title: '報價是否包含系統櫃或其他工項？',
            description:
              '正式報價會列出各項工種與材料；若有增加系統櫃或其他工程，可於討論後一併納入。',
          },
          {
            title: '單一工項也能委託嗎？',
            description:
              '可以，我們接受單項木作或部分工種委託，並能與您既有的設計及工班協作。',
          },
          {
            title: '付款方式與節點？',
            description:
              '通常分為簽約訂金、開工款、進度款與尾款，會依案規模與進度彈性調整。',
          },
        ]}
      />
    </Layout>